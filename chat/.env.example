# Valores por defecto de chat/api/config.py. Cámbialos para tu despliegue.
OLLAMA_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=secretaria
EMBED_MODEL=mxbai-embed-large:latest
LLM_MODEL=llama3.1:8b
RETRIEVAL_LIMIT=12
NUM_PREDICT=450
HISTORY_TURNS=6
EMBED_QUERY_TURNS=3
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@postgres:5432/secretaria_chat
# Centro al que sirve esta instancia: norte o sur (ficticios, como el corpus de ejemplo).
TENANT=norte
