# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=SecretarIA

# ── API de chat (docker-compose.yml) ─────────────────────────────────────────
# Centro al que sirve la instancia: norte o sur (ficticios, como el corpus de ejemplo).
TENANT=norte

# Las dos secciones siguientes solo las usa la primera arquitectura (docker-compose.n8n.yml).
# ── Typebot ───────────────────────────────────────────────────────────────────
TYPEBOT_DB_PASSWORD=cambia_esto
TYPEBOT_ENCRYPTION_SECRET=genera_un_secreto_largo_aleatorio_aqui
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_VIEWER_URL=https://localhost:3443

# GitHub OAuth para login en Typebot (opcional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── n8n ───────────────────────────────────────────────────────────────────────
WEBHOOK_URL=http://host.docker.internal:5678/

# ── Modelos Ollama ────────────────────────────────────────────────────────────
# Desarrollo
LLM_MODEL=llama3.1:latest
# Producción (DGX Spark)
# LLM_MODEL=qwen2.5:72b

EMBED_MODEL=nomic-embed-text:latest
